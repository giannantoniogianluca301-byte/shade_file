def a():
    elementi = "+-/*!&$#?=@abcdefghijklnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890"
    

    password = ""
    for i in range(8):
        password += random.choice(elementi)

    return password




def gen_emodji():
    emodji = ["\U0001f600", "\U0001f642", "\U0001F606", "\U0001F923"]
    return random.choice(emodji)


@bot.event
async def on_ready():
    print(f'Abbiamo fatto l\'accesso come {bot.user}')

@bot.command()
async def meme(ctx):
    with open(f'immagini/{memeimage()}', 'rb') as f:
        # Memorizziamo il file della libreria di Discord convertito in questa variabile!
        picture = discord.File(f)
   # Possiamo quindi inviare questo file come parametro!
    await ctx.send(file=picture)

@bot.command()
async def pulisci(ctx):
    await ctx.channel.purge()


@bot.event
async def on_message(message):
    if message.author == bot.user:
        return
    if message.content.startswith('password'):
        password = a()
        await message.channel.send(password)
    elif message.content.startswith('ciao'):
        await message.channel.send("Ciao!")
    elif message.content.startswith('arrivederci'):
        await message.channel.send("\U0001f642")
    elif message.content.startswith('emoji'):
        await message.channel.send(gen_emodji())
    
    await bot.process_commands(message)


bot.run("metti qui il tuo token")

